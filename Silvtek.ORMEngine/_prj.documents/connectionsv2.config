<?xml version="1.0" encoding="utf-8"?>
<Silvtek.ORMEngine version="1.0">
  <global>
      <map-files path="" />  
      <encoding value="ASCII|UTF8|UTF16" />
      <working-folder path="" />
      <temporary-folder path="" />
      <shared-resources path="" />
      <cache enabled="True|False" />
      <buffer size="2056" />
      <query cache-limit-ms="" />
      <broadcast-changes enabled="True|False" />
  </global>

  <connections>
  <connection name="ORM.TESTERS" default="false" timeout="45000" prepared-statements="True|False" command-timeout="45000" >
    <connection-string>[connection-string]</connection-string>
    <provider class="Silvtek.ORMEngine.MSSql.MSSqlProvider" assembly="Silvtek.ORMEngine" />
    <formatter class="Silvtek.ORMEngine.MSSql.MSSqlType" assembly="Silvtek.ORMEngine" />
    <retries-exceptions>
      <exception type="SqlException" action="Save|Create|Remove|Load">
        <match property="Code" regex="" retries="" />
        <match property="Code" regex="" retries="" />
        <match property="Code" regex="" retries="" />
      </exception>
    </retries-exceptions>
  </connection>
  </connections> 
</Silvtek.ORMEngine>