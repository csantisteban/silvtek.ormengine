<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="dataMapping">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="class">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="table">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string" use="required" />
                  <xs:attribute name="connection-name" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element maxOccurs="unbounded" name="map">
                <xs:complexType>
                  <xs:sequence minOccurs="0">
                    <xs:element minOccurs="0" name="enumInfo">
                      <xs:complexType>
                        <xs:attribute name="type" type="xs:string" use="required"  />
                        <xs:attribute name="convert-by" type="xs:string" use="required">
                          <xs:simpleType>
                            <xs:restriction base="xs:string">
                              <xs:enumeration id="ByName" value="ByName" />
                              <xs:enumeration id="ByValue" value="ByValue" />
                            </xs:restriction>
                          </xs:simpleType>
                        </xs:attribute>
                      </xs:complexType>
                    </xs:element>
                    <xs:element minOccurs="0" maxOccurs="unbounded" name="query-name">
                      <xs:complexType>
                        <xs:attribute name="name" type="xs:string" use="required" />
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="member-name" type="xs:string" use="required" />
                  <xs:attribute name="column-name" type="xs:string" use="required" />
                  <xs:attribute name="datatype" type="xs:string" use="optional" />
                  <xs:attribute name="is-key" type="xs:string" use="optional" />
                  <xs:attribute name="accepts-null" type="xs:string" use="optional" />
                  <xs:attribute name="sequential-type" type="xs:string" use="optional" />
                  <xs:attribute name="length" type="xs:unsignedByte" use="optional" />
                  <xs:attribute name="default-value" type="xs:string" use="optional" />
                  <xs:attribute name="dataType" type="xs:string" use="optional" />
                  <xs:attribute name="accept-null" type="xs:string" use="optional" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="fullname" type="xs:string" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>