<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <!-- Configuration section-handler declaration area. -->
  <configSections>
      <section name="Silvtek.ORMEngine"  type="Silvtek.ORMEngine.Configs.ORMConfigurationHandler, Silvtek.ORMEngineV1.7"  allowLocation="false"/>
    <!-- Other <section> and <sectionGroup> elements. -->
  </configSections>

  <Silvtek.ORMEngine version="1.0">
    <global>
      <map-files path="" />
      <encoding value="ASCII" />
      <working-folder path="" />
      <temporary-folder path="" />
      <shared-resources path="" />
      <cache enabled="true" />
      <buffer size="2056" />
      <query cache-limit-ms="" />
      <broadcast-changes enabled="false" />
    </global>

    <connections>
      <connection name="ORM.TESTERS" default="false" timeout="45000" prepared-statements="False" command-timeout="45000" >
        <connection-string>[connection-string]</connection-string>
        <provider class="Silvtek.ORMEngine.MSSql.MSSqlProvider" assembly="Silvtek.ORMEngineV1.7" />
        <formatter class="Silvtek.ORMEngine.MSSql.MSSqlType" assembly="Silvtek.ORMEngineV1.7" />
        <retry-exceptions>
          <exception type="System.Data.SqlClient.SqlException,System.Data,Version=2.0.0.0, Culture=neutral,PublicKeyToken=b77a5c561934e089 " action="Save,Create,Remove,Load">
            <match property="Number" regex="1205" retries="2" />
          </exception>
          <!--<exception type="System.Data.SqlClient.SqlException,System.Data,Version=1.0.5000.0, Culture=neutral,PublicKeyToken=b77a5c561934e089 " action="Save,Create,Remove,Load">
            <match property="Number" regex="1406" retries="2" />
          </exception>-->
        </retry-exceptions>
      </connection>
    </connections>
  </Silvtek.ORMEngine>
  
</configuration>