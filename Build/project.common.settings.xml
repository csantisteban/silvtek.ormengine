<?xml version="1.0" encoding="utf-8" ?>
<!-- replace with actual value all "template.****} variables -->
<project>
  <!-- TEMPLATE VARIABLES - CUSTOMIZE TO THE BUILD -->
  <property name="template.application-name" value="ORM.Silvtek" />
  <property name="template.company-name" value="Carlos Silva-Santisteban" />
  <property name="project.startdate" value="01/01/2002" />
  
  <property name="template.build-project-type" value="assembly" /><!-- values assembly, webapp, mvc, msbuild -->
  <property name="template.version-source" value="global" /> <!-- valid values 'project', 'global' - project, the version files is located at the project level-->
  <property name="template.strongname-file" value="" /> <!-- comment it, to use default -->
  <property name="build.rootfolder" value="${project::get-base-directory()}" />
  <property name="project.rootfolder" value="${project::get-base-directory()}\..\" />
  <property name="template.global-reference-directory" value="${build.rootfolder}\_prj.references" />
  <property name="template.version-folder" value="${build.rootfolder}\_prj.buildsupport" /> <!-- leave it empty, if about is project -->
  <property name="template.attribute-assembly" value="" />
  <property name="template.ftpupload" value="False" />
  <property name="template.net.frameworks" value="" /> <!-- version net-3.5, net-2.0 or net-1.1-->
  <property name="template.custom.defines" value="" /> <!-- compilation custom defines, for example TEST, BETA, LOCAL, ETC-->
 
  
  <property name="build.types" value="Release" />
  <property name="create.docs" value="False"/>
  
  <!-- valid values are: exe, winexe, library or module. -->
  <property name="build.target" value="library" />

  <!-- this value must match above target. For library = dll, exe=exe, winexe = exe, module=module -->
  <property name="assembly.extension" value="dll" />
  <echo message="Project Root ${project.rootfolder}" />
</project>